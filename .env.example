# Optional. Request a free key at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Keep movies with strictly more than this many IMDb votes. There is no movie-count cap.
CINEGRAPH_MIN_IMDB_VOTES=50000

# Maximum new OMDb requests per ingest run; cached results are reused on later runs.
CINEGRAPH_OMDB_BATCH_SIZE=700
CINEGRAPH_LINKED_DATA=1
